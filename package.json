{
  "name": "leetcode-practice",
  "version": "1.0.0",
  "private": true,
  "description": "LeetCode practice exercises with per-exercise jest tests",
  "scripts": {
    "test": "npm run test:ts && npm run test:cs",
    "test:ts": "jest",
    "test:cs": "node tools/run-csharp-tests.js csharp-results.json --strict",
    "new": "tsx tools/cli/index.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/prompts": "^2.4.9",
    "jest": "^29.7.0",
    "prompts": "^2.4.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
